<section class="gvm-bastion-board" data-gvm-actor-id="{{actorId}}">
  <header class="gvm-bastion-title">
    <h1>{{settlementName}}</h1>
  </header>

  <section class="gvm-defenders-strip">
    <h3><i class="fas fa-shield-alt"></i> Защитники</h3>
    <p>Бастион без защиты.</p>
  </section>

  <div class="gvm-bastion-columns">
    <section class="gvm-bastion-column">
      <header class="gvm-column-header">
        <h3><i class="fas fa-chess-rook"></i> Обычные постройки</h3>
      </header>

      <div class="gvm-facility-list gvm-drop-zone" data-gvm-drop-kind="building" data-gvm-column="common">
        {{#each commonBuildings}}
          {{> "modules/goblin-village-manager/templates/settlement/facility-card.hbs"}}
        {{/each}}

        {{#if isGM}}
        <button type="button" class="gvm-build-placeholder" data-gvm-control="create-building">
          Возвести постройку
        </button>
        {{/if}}
      </div>
    </section>

    <section class="gvm-bastion-column">
      <header class="gvm-column-header">
        <h3><i class="fas fa-landmark"></i> Особые постройки</h3>
        <span>{{limits.specialUsed}} / {{limits.specialMax}}</span>
      </header>

      <div class="gvm-facility-list gvm-drop-zone" data-gvm-drop-kind="building" data-gvm-column="special">
        {{#each specialBuildings}}
          {{> "modules/goblin-village-manager/templates/settlement/facility-card.hbs"}}
        {{/each}}

        {{#if isGM}}
        <button type="button" class="gvm-build-placeholder" data-gvm-control="create-building">
          Возвести постройку
        </button>
        {{/if}}
      </div>
    </section>
  </div>
</section>
